# Выбор провайдера: ollama, yandex, trim, reg
# Конфигурация провайдеров (API-ключи, base URL, модели, лимиты) — в providers.json
# (создаётся из providers.json.example). См. models/providers_config.go.
LLM_PROVIDER=ollama

# Выбор модели (если не задано — используется default_model из providers.json)
# MODEL=qwen3-coder:30b

# Большая модель для «тяжёлых» агентов (Лид, Архитектор, Ревьюер). Если задана,
# маленькая (MODEL) используется для рядовых разработчиков, а эта — для
# агентов, требующих высокого качества рассуждения (см. LayeredProvider).
# Если не задано — используется large_model из providers.json.
# MODEL_LARGE=

# Для агента codereviewer нужно указать доступ к gitlab, access_token с scope: api, read_api
GITLAB_TOKEN=
# Для GitHub — token с scope: repo (или public_repo для публичных репозиториев)
GITHUB_TOKEN=

# Git submodules: 0 disables initialization; otherwise they are initialized
# when a Git project is opened. Optional positive depth makes submodule clones
# shallow and limits their history.
GITOPS_SUBMODULES=1
GITOPS_SUBMODULE_DEPTH=

# Таймаут всего цикла агента (парсится через time.ParseDuration), по умолчанию 10m.
# Дефолт заведомо больше таймаута одного HTTP-запроса провайдера (5 минут).
# Для большого ревью может потребоваться больше, например: 15m
REVIEW_TIMEOUT=

# Настройки агента код-ревью (Feature 1,2,6,9)
# Лимит замечаний за одно ревью (0 = без лимита), по умолчанию 10
# Сколько замечаний максимум публикуется за одно ревью, по умолчанию 10.
# 0 — без лимита.
REVIEW_MAX_COMMENTS=10
# Публиковать только критические замечания (баги, падения, уязвимости,
# гонки, утечки ресурсов). Стиль/«можно лучше»/«стоит проверить» отсекаются
# и не пачкают MR. true/false, по умолчанию true.
REVIEW_CRITICAL_ONLY=true
# Блокировать апрув при наличии критичных замечаний ("критично:"), по умолчанию true
REVIEW_BLOCK_ON_CRITICAL=true
# Отсекать сгенерированные/бинарные файлы из анализа, по умолчанию true
REVIEW_SKIP_GENERATED=true
# Размер (в байтах) диффа ревьювера, с которого он начинает обрезаться, чтобы
# не переполнять контекст модели (по умолчанию 300000 ≈ 300 КБ).
# При превышении в ответе ревьювера добавляется примечание об обрезании.
REVIEW_MAX_DIFF_SIZE=300000
# Размер (в символах) диффа, с которого он ревьюится по частям, чтобы не
# переполнять контекст модели и снижать галлюцинации. 0 = без разбиения. по умолчанию 14000
REVIEW_CHUNK_SIZE=14000
# Максимум раундов (циклов модель->инструменты) за ревью, по умолчанию 12.
# Ревью по частям большого диффа может требовать больше
REVIEW_MAX_ROUNDS=12
# Максимум циклов «ревью → исправление → ревью» для шага codereviewer
# в планировщике (замечания ревью превращаются в шаги refactor, затем ревью
# повторяется; 1 = один проход ревью без цикла исправлений), по умолчанию 3
REVIEW_FIX_ROUNDS=3

# Разрыв петли (runner/loop.go). Детектор ловит, что агент топчется на одном
# и том же, и вместо очередной подсказки в промпте ОБРЫВАЕТ историю: снимает
# зацикленный хвост, оставляет постановку задачи и даёт указание взять задачу с
# другой стороны. Дополнительно модель получает постановку задачи заново и
# список уже тронутых файлов — с требованием перечитать их перед новой работой.
# Если и после разрыва модель повторяет забаненный вызов — запуск падает с
# «зациклился», а задача не помечается выполненной.
# Сколько раз подряд повторяется один и тот же вызов (сигнатура = имя + аргументы).
LOOP_SIG_REPEATS=3
# Сколько раундов подряд без единого успешного вызова.
LOOP_FAIL_STREAK=5
# Сколько раундов подряд агент только читает, ни разу не изменив проект.
LOOP_NO_WRITE=16
# Сколько раундов подряд проект может НЕ меняться при одной и той же падающей
# проверке. Отпечаток состояния — НОРМАЛИЗОВАННАЯ САМА ПРОВЕРКА: отбрасываются
# конвейер после | (grep/tail/head и его флаги), перенаправления и каталог в
# `cd X &&`. Отпечаток по выводу не годится: grep -A5 и grep -B3 -A20 печатают
# разные куски одного и того же падения — вывод меняется каждый раунд и маскирует
# петлю, а проверка остаётся той же.
LOOP_STATE_REPEATS=3
# На каком повторе неподвижной проверки харнес вмешивается СИЛЬНЫМ
# предупреждением, не дожидаясь разрыва петли: сообщение уходит в следующий
# запрос к модели (после схлопывания истории оно пропало бы вместе с ней), а
# повторный запуск этой проверки временно блокируется. Держите меньше
# LOOP_STATE_REPEATS, иначе предупреждение придёт уже после разрыва.
LOOP_STATE_WARN=2
# Сколько одинаковых падений проверки (тесты/сборка/линт) подряд включает
# принудительное вмешательство: модель получает диагноз (нормализованный вывод
# ошибки) и требование сменить стратегию, а повторный запуск этой проверки
# блокируется на LOOP_VERIFY_BLOCK_ROUNDS раундов.
LOOP_VERIFY_FAILS=5
LOOP_VERIFY_BLOCK_ROUNDS=1
# Сколько раз агент может проигнорировать разрыв и повторить забаненный вызов,
# прежде чем запуск будет провален (2 = ещё одна попытка, но не бесконечная).
LOOP_MAX_STRIKES=2
# Сколько раз за запуск разрешен разрыв петли; исчерпаны — сразу провал.
LOOP_MAX_BREAKS=2
# Сколько последних вызовов попадает в дайджест «что уже делали и чем кончилось».
LOOP_DIGEST_MAX=8

# Настройки агента-генератора кода
# Целевой язык программирования, по умолчанию Go
CODEGEN_LANG=Go
# Имя модуля Go для go.mod (пусто — модель придумывает сама)
CODEGEN_MODULE=
# Максимум записываемых файлов за запуск (0 = без лимита)
CODEGEN_MAX_FILES=0
# Запрещать перезапись уже существующих файлов, по умолчанию false
CODEGEN_NO_OVERWRITE=false
# Имя файла-отчёта после генерации (пусто — отключить), по умолчанию SUMMARY.md
CODEGEN_SUMMARY_FILE=SUMMARY.md
# Верхняя граница символов, считываемых из одного файла (по умолчанию 100000 ≈ 100 КБ).
# Файл больше этого размера не обрезается молча: в ответе приходят has_more и
# next_offset, и модель дочитывает хвост явным повторным вызовом с offset.
# Является верхней границей для CODEGEN_READ_CHUNK.
CODEGEN_READ_MAX_FILE=100000
# Порция чтения на файл в одном вызове ReadFiles (по умолчанию 16384 ≈ 16 КБ).
# Задаёт предсказуемый размер сообщения раунда: при меньшем значении модель
# получает меньший кусок и дочитывает остаток через offset.
CODEGEN_READ_CHUNK=16384
# Сколько файлов ReadFiles возвращает за один вызов (по умолчанию 3).
# Модель склонна заказывать 8-14 файлов разом; лишние получают status
# "skipped" с подсказкой дочитать их отдельным вызовом (мягкий лимит).
CODEGEN_READ_MAX_FILES=3
# Максимум символов, считываемых за один вызов CodegenReadFiles (по умолчанию 800000 ≈ 800 КБ).
# Если суммарный объём файлов превышает лимит, читаются файлы по убыванию
# приоритета (main.go/payload.before/small.snippet), остальные — имена.
CODEGEN_READ_MAX_TOTAL=800000
# Таймаут команды инструмента Run (например "90s"), по умолчанию 60s.
# Долгоживущие команды (npm run dev, сервер) прерываются и возвращают
# модели понятную ошибку о таймауте, а не вешают шаг навсегда.
CODEGEN_RUN_TIMEOUT=60s

# ---------------------------------------------------------------------------
# Песочница выполнения (tools/sandbox.go, образ sandbox/Dockerfile).
#
# Команды из Run приходят от модели, поэтому по умолчанию они идут на ХОСТЕ
# (CODEGEN_SANDBOX пуст) — это осознанно: молчаливый перенос всего исполнения
# (сборка, тесты, ЛСП-чекер) в контейнер ломает проекты по неочевидной
# причине. Включается явно, одним из двух значений:
#   container (1/on/true/yes/docker) — всегда контейнер; нет Docker → ошибка
#                                     конфигурации, НЕ тихий возврат на хост;
#   auto                            — контейнер при доступном Docker, иначе
#                                     хост с пометкой sandbox_note в ответе;
#   пусто / 0 / off / false / no / local / host — хост (поведение по умолчанию).
CODEGEN_SANDBOX=

# Образ песочницы. Пусто = выбирается по стеку проекта (go.mod → golang:1.24,
# package.json → node:22, requirements.txt/pyproject.toml → python:3.12,
# composer.json → php:8.3-cli), а если стек не распознан — dev-образ
# ai-sandbox:latest (монорепо и make-цели вида `make build`).
# Dev-образ нужно собрать один раз:
#   SANDBOX_UID=$(id -u) SANDBOX_GID=$(id -g) docker compose -f sandbox/compose.yaml build
# Алиас для обратной совместимости: CODEGEN_IMAGE.
CODEGEN_SANDBOX_IMAGE=
# CODEGEN_IMAGE=

# Сеть контейнера: default (мост docker) | none | bridge.
# По умолчанию сеть ЕСТЬ — без неё `go mod download` и `npm ci` не работают.
# CODEGEN_SANDBOX_NETWORK=none отключает её полностью; тогда модели нужны
# локальные кэши (vendor/, GOMODCACHE, node_modules, .venv), а в ответе
# появляется подсказка sandboxNetworkHelp.
CODEGEN_SANDBOX_NETWORK=default

# Лимиты ресурсов контейнера (docker run --memory/--cpus).
CODEGEN_SANDBOX_MEMORY=2g
CODEGEN_SANDBOX_CPUS=2

# Read-only КОРЕНЬ контейнера (--read-only). Кэши и HOME лежат в tmpfs /tmp,
# поэтому тулчейн продолжает работать. Рабочий каталог проекта при этом
# остаётся доступным НА ЗАПИСЬ: это файлы, которые агент правит по заданию.
# Рекомендуется для приёмки и режима «только посмотреть».
CODEGEN_SANDBOX_RO=false

# Запись в рабочий каталог проекта. По умолчанию РАЗРЕШЕНА (пустое значение =
# разрешено) — монтируется :rw. Значение false монтирует :ro: команда,
# которая пишет в проект, упадёт с ошибкой, а не «успешно» не сделает работу.
CODEGEN_SANDBOX_ALLOW_WRITE=true

# Путь к клиенту docker. Читается ДО поиска в PATH, поэтому сюда можно положить
# абсолютный путь для CI и машин без docker в PATH.
CODEGEN_SANDBOX_DOCKER=

# Альтернативный сокет/демон docker, если демон не на /var/run/docker.sock.
# Эти имена нужны потому, что переменные DOCKER_* в окружении агента могут быть
# заняты чем-то ещё.
# CODEGEN_DOCKER_HOST=
# CODEGEN_DOCKER_TLS=
# CODEGEN_DOCKER_CERT=
# Путь к docker, который песочница подставляет дочернему compose-процессу.
# CODEGEN_SANDBOX_BIN=
# UID хоста для сборки образа (аргумент build в sandbox/compose.yaml).
# CODEGEN_SANDBOX_USER=

# ---------------------------------------------------------------------------
# Логи рантайма приложения (tools/applogs.go, runner/applog.go).
# Инструмент ReadAppLogs запускает приложение, слушает stdout+stderr и
# отдаёт хвост; эти флаги управляют обратным каналом — автоподмешиванием
# логов в промпт модели, чтобы агент сам починил panic или занятый порт.
# Включено по умолчанию. Выключается APP_LOG_AUTO_FEED=0/false/off/no.
APP_LOG_AUTO_FEED=1
# Сколько раз за цикл логи подмешиваются заново, пока модель не починит
# (2 — хватает, чтобы увидеть эффект правки, и не засоряет контекст).
APP_LOG_MAX_FEED_ROUNDS=2

# Расширенное сжатие истории агентского цикла (runner/compression.go).
# Базовое сжатие включается только вместе с CODEGEN_HISTORY_BUDGET>0; без него
# действует лишь страховка по окну контекста провайдера. Все побочные фичи
# опциональны (выкл по умолчанию) и не роняют генерацию при недоступности.
# Толкуют 1/true/yes/on как включено.
# Бюджет истории в символах (0 = сжатие выключено; ~4 символа ≈ 1 токен)
CODEGEN_HISTORY_BUDGET=0
# Токен-лимит по фактическому usage провайдера (0 = выкл, Ф-11): если вход
# прошлого раунда выше лимита — следующий сжимается жёстче (лимит × 4 символов)
CODEGEN_HISTORY_TOKENS=0
# Памятка модели о сжатии (Ф-6): в system дописывается, что старые шаги убраны
# и их детали надо дочитывать инструментами (CodeSearch/ReadFiles/LSP)
CODEGEN_HISTORY_NOTICE=false
# Вытеснение выброшенных юнитов в RAG-«эпизоды» памяти (Ф-7), псевдо-проект
# @episodes:<project>; требует подключённый rag-клиент (runctx.WithCompression)
CODEGEN_HISTORY_EVICT=false
# Семантический выбор кандидатов на выброс по близости к задаче (Ф-8);
# требует rag-клиент (эмбеддинги Similarity)
CODEGEN_HISTORY_RANK=false
# LSP-оглавления убранных файлов в памятке (Ф-9): имена+диапазоны, точечный
# дочит вместо чтения файла заново; требует языковой сервер
CODEGEN_HISTORY_OUTLINE=false
# Компакция выброшенной середины в «протокол» одним вызовом модели (Ф-10)
CODEGEN_HISTORY_COMPACT=false

# Настройки агентов DevOps: DevOps Engineer (go run . devops <имя> <промпт>)
# и DevOps Lead (go run . devopslead <имя> <промпт>, переиспользует те же
# переменные). Пишут и оптимизируют инфраструктурный код (Docker Compose,
# Kubernetes, CI/CD, Dockerfile) и проверяют его запуском команд.
# Максимум записываемых файлов за запуск (0 = без лимита)
DEVOPS_MAX_FILES=0
# Запрещать перезапись уже существующих файлов, по умолчанию false
DEVOPS_NO_OVERWRITE=false

# Настройки агентов QA: QA Engineer (go run . qa <имя> <промпт>) и
# QA Lead (go run . qalead <имя> <промпт>, переиспользует те же переменные).
# Проверяют соответствие API-контрактам, пишут стабильные автотесты,
# запускаемые единой консольной командой, и составляют баг-репорты.
# Максимум записываемых файлов за запуск (0 = без лимита)
QA_MAX_FILES=0
# Запрещать перезапись уже существующих файлов, по умолчанию false
QA_NO_OVERWRITE=false
# Имя файла-отчёта о тестировании (пусто — отключить), по умолчанию TEST_REPORT.md
QA_REPORT_FILE=TEST_REPORT.md

# Настройки агента Frontend Tech Lead (go run . frontendlead <имя> <промпт>):
# проектирует клиентскую архитектуру и декомпозирует интерфейс на задачи для
# фронтенд-разработчиков. Ответ — строго JSON по заданной схеме.
# Максимум записываемых файлов за запуск (0 = без лимита)
FRONTEND_MAX_FILES=0
# Запрещать перезапись уже существующих файлов, по умолчанию false
FRONTEND_NO_OVERWRITE=false
# Имя файла, куда агент дублирует JSON-декомпозицию (пусто — отключить),
# по умолчанию FRONTEND_PLAN.json
FRONTEND_PLAN_FILE=FRONTEND_PLAN.json

# Настройки агента Backend Tech Lead (go run . backendlead <имя> <промпт>):
# верхнеуровневое проектирование и декомпозиция бэкенда на атомарные задачи.
# Ответ — строго JSON по заданной схеме.
# Максимум записываемых файлов за запуск (0 = без лимита)
BACKEND_MAX_FILES=0
# Запрещать перезапись уже существующих файлов, по умолчанию false
BACKEND_NO_OVERWRITE=false
# Имя файла, куда агент дублирует JSON-декомпозицию (пусто — отключить),
# по умолчанию BACKEND_PLAN.json
BACKEND_PLAN_FILE=BACKEND_PLAN.json

# Настройки приёмки: финальный шаг qa в плане — сборка, запуск готового
# приложения и проверка логов на ошибки. go run . accept <имя_проекта> выполняет
# приёмку отдельно (без LLM).
# Команды сборки/запуска (через sh -c в директории проекта). Пусто — автодетект
# по типу проекта: go.mod (Go), package.json (Node), requirements.txt (Python).
# Node без точки входа (index.js/main/server.js/app.js и т.п.) считается
# статическим фронтендом: приёмка — по сборке, предупреждением. Если в корне
# проекта нет маркеров, а в прямых подкаталогах (frontend/, server/) есть —
# это монорепозиторий: каждый подпроект принимается отдельно, отчёт содержит
# блоки по подпроектам (main.go: accept печатает их по одному).
ACCEPT_BUILD_CMD=
ACCEPT_RUN_CMD=
# Установка зависимостей перед сборкой: go mod download / npm ci (если есть
# package-lock.json) или npm install / pip install -r requirements.txt.
# Таймаут установки по умолчанию 5m. Инструмент не найден — шаг пропускается.
ACCEPT_INSTALL_DEPS=true
ACCEPT_INSTALL_CMD=
ACCEPT_INSTALL_TIMEOUT=5m
# Таймауты сборки и запуска (time.ParseDuration), по умолчанию 2m и 10s
ACCEPT_BUILD_TIMEOUT=2m
ACCEPT_RUN_TIMEOUT=10s
# Сколько циклов «приёмка → планировщик исправлений → приёмка» допускается в
# исполнителе плана, по умолчанию 3. 0 — исправления по приёмке не выполняются.
ACCEPT_MAX_ROUNDS=3
# Максимум символов вывода сборки/запуска в отчёте, по умолчанию 6000
ACCEPT_MAX_LOG=6000
# Проверка стилизатора (gofmt/prettier/black): нарушения — предупреждения,
# вердикт не меняют. Анализатор (go vet/eslint/ruff): находки — ошибки, ведут к
# reject. Инструмент не найден — проверка пропускается (не ошибка).
# true/false, по умолчанию true. Переопределение команд — вручную.
ACCEPT_FORMAT=true
ACCEPT_ANALYZE=true
ACCEPT_FORMAT_CMD=
ACCEPT_ANALYZE_CMD=

# режим дебагинг
LLM_DEBUG=1

# Настройки контрольных точек планировщика (команда plan)
# Чекпоинты включаются автоматически, если задан REDIS_ADDR (или явно
# PLAN_CHECKPOINT=1), а также при запросе resume (флаг --resume / PLAN_RESUME=1).
# Состояние выполнения хранится в Redis (поднимается docker-compose).
REDIS_ADDR=localhost:56379
# REDIS_PASSWORD=
# Номер базы Redis, по умолчанию 0
# REDIS_DB=0
# TTL чекпоинта (time.ParseDuration), 0 = без истечения. По умолчанию 0.
# PLAN_CHECKPOINT_TTL=24h

# Настройки Kanban-доски (команда kanban)
# Общая Redis-доска проекта: Системный архитектор публикует эпики вызовом
# submit_architecture_backlog, лиды декомпозируют их на JSON-задачи,
# планировщик ведёт доску до решения. Redis поднимается docker-compose.
# Адрес Redis (по умолчанию localhost:56379)
BOARD_REDIS_ADDR=localhost:56379
# Пароль Redis (пусто — без пароля)
# BOARD_REDIS_PASSWORD=
# Номер базы Redis, по умолчанию 0
# BOARD_REDIS_DB=0
# TTL записей доски (time.ParseDuration), 0 = без истечения. По умолчанию 0.
# BOARD_TTL=24h

# Настройки Web UI (go run . serve)
# Адрес HTTP-сервера Web UI, по умолчанию 127.0.0.1:8090.
# AI_WEB_ADDR=0.0.0.0:8090
# Пароль Web UI: если задан, включается простой логин (HTTP-сессия ai_sid
# + CSRF-токен) и per-IP rate-limit (5 попыток входа/минуту, 120 запросов
# к /api/*, 30 сообщений в чат). Пустой пароль — защита выключена (default).
AI_WEB_PASSWORD=

# Настройки векторной памяти RAG (Qdrant + эмбеддинги Ollama)
# Адрес Qdrant gRPC (порт 56334), поднимается docker-compose (compose.yaml).
QDRANT_ADDR=localhost:56334
# Имя коллекции чанков кода (создаётся автоматически при индексации)
QDRANT_COLLECTION_NAME=project_code_base
# Модель эмбеддингов Ollama (используется для индексации и поиска)
EMBEDDING_MODEL=nomic-embed-text
# Лимит выдачи инструмента CodeSearch (Ф-3), по умолчанию 3
# RAG_MAX_RESULTS=3
# Суммарный лимит текста результата поиска (символов), по умолчанию 150000
# RAG_READ_MAX_TOTAL=150000
# Таймаут одного поиска CodeSearch (Ping + эмбеддинг + запрос в Qdrant),
# time.ParseDuration, по умолчанию 30s
# RAG_SEARCH_TIMEOUT=30s
# Контекст RAG планировщика (Ф-4): подмешивание блока «релевантный код по
# задаче» в карту проекта и по шагам плана; 0/false/off/no — выключить
RAG_PLANNER_CONTEXT=1
# Авто-переиндексация RAG после мутаций (Ф-5): в том же хуке, что и авто-
# лечение LSP, файлы, затронутые раундом, заново индексируются в Qdrant
# (удалённые — чистятся); 1/true/on/yes — включить. По умолчанию выключена:
# индекс собирается явной командой `go run . index <проект>`; без Qdrant
# переиндексация молча пропускается (degrade)
# RAG_AUTO_REINDEX=0

# Промпт-инъекции: дополнительные префиксы переменных окружения, которые
# разрешено читать шаблону {{env.*}} (через запятую). Без этой переменной
# инъекция видит только AI_*, CODEGEN_*, OLLAMA_*, KANBAN_*; имена вида
# *_API_KEY, *_TOKEN, *_SECRET, *_PASSWORD запрещены всегда, даже если
# префикс попал сюда (подставляется [REDACTED]). Нужно, чтобы инструкция в
# инъекции могла сослаться на своё окружение, не открывая весь environ.
# AI_INJECTION_ENV_ALLOW=MYAPP_

# Настройки команды-слушателя новых MR: go run . listen
# Адрес GitLab (без завершающего слэша)
GITLAB_URL=
# Список ID проектов для мониторинга через запятую
GITLAB_PROJECTS=
# Файл-база известных MR (создаётся автоматически)
DB_FILENAME=discovered_mrs.txt
# Интервал опроса (time.ParseDuration), по умолчанию 30s
POLL_INTERVAL=30s
