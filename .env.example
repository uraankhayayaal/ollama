# ollama: Запуск с локальной Ollama
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:30b

# yandex: Запуск с YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=b1g4i7484no974fajk10
YANDEX_MODEL=qwen3.6-35b-a3b/latest

# trim: Запуск с Trim API
TRIM_API_KEY=
TRIM_HOST=https://vllm-app.rc.itops.su/v1
TRIM_MODEL=/models/T-pro-it-1.0

# Выбор провайдера: ollama, yandex, trim
LLM_PROVIDER=trim

# Для агента codereviewer нужно указать доступ к gitlab, access_token с scope: api, read_api
GITLAB_TOKEN=
# Для GitHub — token с scope: repo (или public_repo для публичных репозиториев)
GITHUB_TOKEN=

# Таймаут всего цикла агента (парсится через time.ParseDuration), по умолчанию 5m.
# Для большого ревью может потребоваться больше, например: 15m
REVIEW_TIMEOUT=

# Настройки агента код-ревью (Feature 1,2,6,9)
# Лимит замечаний за одно ревью (0 = без лимита), по умолчанию 10
REVIEW_MAX_COMMENTS=10
# Блокировать апрув при наличии критичных замечаний ("критично:"), по умолчанию true
REVIEW_BLOCK_ON_CRITICAL=true
# Отсекать сгенерированные/бинарные файлы из анализа, по умолчанию true
REVIEW_SKIP_GENERATED=true
# Размер (в символах) диффа, с которого он ревьюится по частям, чтобы не
# переполнять контекст модели и снижать галлюцинации. 0 = без разбиения. по умолчанию 14000
REVIEW_CHUNK_SIZE=14000
# Максимум раундов (циклов модель->инструменты) за ревью, по умолчанию 12.
# Ревью по частям большого диффа может требовать больше
REVIEW_MAX_ROUNDS=12

# Настройки агента-генератора кода
# Целевой язык программирования, по умолчанию Go
CODEGEN_LANG=Go
# Имя модуля Go для go.mod (пусто — модель придумывает сама)
CODEGEN_MODULE=
# Максимум записываемых файлов за запуск (0 = без лимита)
CODEGEN_MAX_FILES=0
# Запрещать перезапись уже существующих файлов, по умолчанию false
CODEGEN_NO_OVERWRITE=false
# Имя файла-отчёта после генерации (пусто — отключить), по умолчанию SUMMARY.md
CODEGEN_SUMMARY_FILE=SUMMARY.md
# Число раундов self-repair (исправление по замечаниям ревью), по умолчанию 3.
# 0 или отрицательное — исправление отключено.
CODEGEN_MAX_REPAIR_ROUNDS=3

# режим дебагинг
LLM_DEBUG=1
