# Конфигурация для МАКБУК ЭЙР M1 / 16 ГБ (слабое железо, локально через Ollama/LM Studio)
# Копировать в .env либо подключать селективно: set -a; source .env.macbook.air; set +a
#
# Модель: 8B в кванте Q4_K_M (ок. 5 ГБ, влезает в 16 ГБ с запасом через Metal).
# Примеры имён: qwen3:8b, qwen2.5-coder:7b, llama3.1:8b, mistral:7b
# НЕ брать Q5/Q6/Q8/FP16 — выйдет из памяти и уйдёт в своп.
#
# Память: M1 Air — всего 68 ГБ/с (в ~7 раз уже, чем у M3 Max), поэтому окно
# контекста держим в 8K: на 16K+ prompt processing и KV-кэш уже заметно
# тормозят. ВАЖНО: без OLLAMA_INPUT_TOKENS приложение форсирует num_ctx=32000
# из своего дефолта — для 8B на M1 это минуты на обработку и риск вылета из
# памяти. Окно задано явно ниже.

LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Контекст и thinking (Ollama), см. models/ModelSettings.go ---
# Окно входа (num_ctx) на запрос: 8192 — достаточно для ревью диффов до 6000
# символов по частям и короткой истории tool-цикла.
OLLAMA_INPUT_TOKENS=8192
# Лимит выхода (num_predict): меньше дефолта, чтобы ответ приходил быстрее.
OLLAMA_OUTPUT_TOKENS=4096
# qwen2.5-coder не умеет thinking — OLLAMA_THINK_TOKENS бесполезен до тех пор,
# пока модель не сменена на reasoning-модель (qwen3:8b). Тогда:
# OLLAMA_THINK_TOKENS=3000   # "medium"

# --- Таймауты: 8B на M1 генерирует медленно (15-25 tok/s) ---
# Общий таймаут всего цикла агента. Для генератора/самопроверки с несколькими
# раундами repair хватит с запасом.
REVIEW_TIMEOUT=10m

# --- Настройки ревью: снижаем нагрузку и размер диффов, чтобы влезало в 8K контекст ---
# Лимит замечаний за одно ревью (меньше = меньше токенов на вывод и истории)
REVIEW_MAX_COMMENTS=6
# Блокировать апрув при критичных замечаниях
REVIEW_BLOCK_ON_CRITICAL=true
# Отсекать сгенерированные/бинарные файлы (экономим контекст)
REVIEW_SKIP_GENERATED=true
# Дифф длиннее этого ревьюится по частям. Уменьшаем с 14000 до 6000,
# чтобы куски диффа гарантированно влезали в 8K контекст модели.
REVIEW_CHUNK_SIZE=6000
# Раунды «модель->инструмент» за ревью (ниже дефолта, чтобы не жечь время)
REVIEW_MAX_ROUNDS=6

# --- Настройки генератора кода ---
CODEGEN_LANG=Go
CODEGEN_MODULE=
CODEGEN_MAX_FILES=0
CODEGEN_NO_OVERWRITE=false
CODEGEN_SUMMARY_FILE=SUMMARY.md

# --- Прочее ---
# Подробный лог запросов/ответов моделей (полезно видеть, где тормозит)
LLM_DEBUG=1
