# Конфигурация для RTX 5070 Ti / 16 ГБ (локально через Ollama)
# Копировать в .env либо подключать селективно: set -a; source .env.rtx5070ti; set +a
#
# Модель: qwen3.8-27b-ud-iq3s (IQ3S, ок. 11 ГБ весов).
# Верифицировано на этой машине: Ollama обслуживает модель с num_ctx=32768,
# num_predict=8192 — KV-кэш помещается в 16 ГБ с запасом.
# Те же размеры выравнены с конфигом opencode (limit.context=32768,
# limit.output=8192), см. ~/.config/opencode/opencode.jsonc.

LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.8-27b-ud-iq3s:latest
# Большая модель для «тяжёлых» агентов (Лид, Архитектор, Ревьюер).
# Пусто — все агенты ходят на OLLAMA_MODEL. Задать, например: OLLAMA_MODEL_LARGE=
OLLAMA_MODEL_LARGE=

# --- Контекст и thinking (Ollama), см. models/ModelSettings.go ---
# Окно входа (num_ctx) на запрос: совпадает с num_ctx моделфайла и opencode.
OLLAMA_INPUT_TOKENS=32768
# Лимит выхода (num_predict): совпадает с num_predict моделфайла.
OLLAMA_OUTPUT_TOKENS=8192
# Бюджет thinking -> уровень рассуждения: 4000 = "medium".
OLLAMA_THINK_TOKENS=4000

# --- Таймаут всего цикла агента (пусто = дефолт 5m) ---
# REVIEW_TIMEOUT=15m

# --- Настройки ревью: 16 ГБ и 32K контекст держат дефолтные значения ---
# Лимит замечаний за одно ревью
REVIEW_MAX_COMMENTS=10
# Публиковать только критические замечания (шум отсекается), по умолчанию true
REVIEW_CRITICAL_ONLY=true
# Блокировать апрув при критичных замечаниях
REVIEW_BLOCK_ON_CRITICAL=true
# Отсекать сгенерированные/бинарные файлы из анализа
REVIEW_SKIP_GENERATED=true
# Размер (в байтах) диффа, с которого он обрезается целиком
REVIEW_MAX_DIFF_SIZE=300000
# Размер (в символах) диффа, с которого он ревьюится по частям
REVIEW_CHUNK_SIZE=14000
# Раундов «модель->инструмент» за ревью
REVIEW_MAX_ROUNDS=50
# Циклы «ревью → исправление → ревью» в планировщике, по умолчанию 3
REVIEW_FIX_ROUNDS=3

# --- Настройки генератора кода ---
CODEGEN_LANG=Go
CODEGEN_MODULE=
CODEGEN_MAX_FILES=0
CODEGEN_NO_OVERWRITE=false
CODEGEN_SUMMARY_FILE=SUMMARY.md
# Максимум символов из одного файла и за один вызов чтения (защита контекста)
CODEGEN_READ_MAX_FILE=100000
CODEGEN_READ_MAX_TOTAL=800000
# Таймаут команды инструмента Run, по умолчанию 60s
CODEGEN_RUN_TIMEOUT=60s

# --- Доступ к Git-хостингам (codereviewer публикует замечания и MR) ---
# GITLAB_TOKEN=
# GITHUB_TOKEN=

# --- Прочее ---
# Подробный лог запросов/ответов моделей
LLM_DEBUG=1